# The lockfile is only valid for the npm that wrote it: npm 10 and npm 11
# disagree about which tree a given package.json resolves to, so a lockfile
# written by one can be rejected by the other. `engines` in package.json names
# the one Node this repo builds with; engine-strict turns npm's advisory
# EBADENGINE warning into a refusal, because a precondition nobody enforces is
# not a precondition. Use .nvmrc to get that Node.
engine-strict=true

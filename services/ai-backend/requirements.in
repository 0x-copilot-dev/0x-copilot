# SQLite-backed LangGraph checkpointer for the single_user_desktop file store
# (durable graph/approval continuation across worker restart). Desktop path
# only; postgres/in-memory keep InMemorySaver.
langgraph-checkpoint-sqlite==3.1.1
# `import aiosqlite` in execution/deep_agent_builder.py is a DIRECT import even
# though langgraph-checkpoint-sqlite also requires it.
aiosqlite==0.22.1
# Postgres-backed LangGraph checkpointer (T3.2): the server topology's durable
# graph continuation, the sibling of the sqlite saver above. Added on `dev`
# after this file was first compiled, so it arrived as a merge conflict rather
# than as a resolver change — pinning it here is what keeps the lock honest.
# MultiServerMCPClient + descriptor conversion (capabilities/mcp/tool_source.py).
langchain-mcp-adapters==0.3.2
openai==2.53.0
anthropic==0.120.2
# Upstream authority for provider model metadata, pricing, and preflight token
# counting. Never replaced by a locally-maintained per-model catalog.
litellm==1.97.0
ddgs==9.15.0
# Main-content extraction for `web_search` (PRD local-search-extraction, S1).
# Search gives us four URLs; this turns each page into the article text a
# snippet-anchored window can be cut from. Without it the whole extraction path
# degrades to returning the engine snippet — which is correct, and is also why
# the feature shipped inert: the code was live and the dependency was not.
trafilatura==2.2.0


node_modules/
dist/
.vite/
.pytest_cache/
__pycache__/
.venv/
.env
.claude/
.cursor/
.agents/
.codex/
*.egg-info/
build/

# Python coverage artifacts — regenerated by every `pytest --cov` run, so they
# churn as modified files in unrelated work. Covers all services/* (only
# ai-backend currently has pytest-cov installed) and tools/*.
.coverage
.coverage.*
coverage.xml
htmlcov/

# Local one-off scripts / scratch (not part of the product)
scratch/

# Desktop runtime staging output (binaries staged by tools/desktop-runtime/stage.mjs)
apps/desktop/resources/

.DS_Store

# Repo-local `gh` CLI config directories. hosts.yml inside these holds a LIVE
# OAuth token, and this repository is public -- committing one publishes a
# working GitHub credential. Ignored by pattern rather than by exact name so a
# second account's directory cannot be added without also being ignored.
.gh-cli-*/

        {
          "sequence_no": 1,
          "event_type": "reasoning_summary_delta",
          "payload": { "summary": "Plan: ", "delta": "Plan: " }
        },
        {
          "sequence_no": 2,
          "event_type": "reasoning_summary_delta",
          "payload": { "summary": "Plan: step 1", "delta": "step 1" }
        },
        {
          "sequence_no": 3,
          "event_type": "model_delta",
          "payload": { "delta": "Done", "message": "Done" }

        {
          "sequence_no": 1,
          "event_type": "model_delta",
          "payload": { "delta": "Looking." }
        },
        {
          "sequence_no": 2,
          "event_type": "tool_call_started",
          "payload": {}
        },
        {
          "sequence_no": 3,
          "event_type": "final_response",
          "payload": { "message": "Here is the answer." }

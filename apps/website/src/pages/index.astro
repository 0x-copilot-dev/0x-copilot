---
import Base from "../layouts/Base.astro";
import Nav from "../components/Nav.astro";
import "../styles/home.css";

const REPO = "https://github.com/0x-copilot-dev/0x-copilot";
const DISCORD = "https://discord.com/invite/NhCv7zDkmX";
const X = "https://x.com/Copilot0x";
const VIRTUALS = "https://app.virtuals.io/virtuals/113720";

const JOURNEY = [
  {
    no: "01",
    stage: "BEFORE THE RUN",
    title: "Name the outcome.",
    body: "Start in the Run workspace with the job, the relevant files, and the tools you want available. The agent turns that intent into a plan.",
    screen: "RUN / GOAL COMPOSER",
  },
  {
    no: "02",
    stage: "DURING THE RUN",
    title: "See the work. Stop the risk.",
    body: "The active run is the product’s proof point: live tool events, work taking shape, and a real approval waiting before anything consequential happens.",
    screen: "ACTIVE RUN / APPROVAL",
  },
  {
    no: "03",
    stage: "AFTER THE RUN",
    title: "Keep the result and the receipt.",
    body: "Return to the finished artifact, its sources, and the activity trail. The useful output survives the conversation—and so does the evidence.",
    screen: "RESULT / ACTIVITY",
  },
];

const SURFACES = [
  ["01", "Run", "Start with an outcome"],
  ["02", "Chats", "Keep the conversation"],
  ["03", "Projects", "Carry shared context"],
  ["04", "Activity", "Audit every move"],
  ["05", "Tools", "Connect real systems"],
  ["06", "Skills", "Repeat what works"],
];
---

<Base
  title="0xCopilot — the job is the product"
  description="A local, open-source desktop agent that works across your files and tools, streams every step, and pauses for approval before it acts."
  bodyClass="home-site"
  themeColor="#f2eddf"
  fontHref="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wdth,wght@12..96,75..100,300..800&family=DM+Mono:wght@300;400;500&family=Instrument+Serif:ital@0;1&display=swap"
>
  <Nav variant="nav-home" />

  <main>
    <header class="home-hero">
      <div class="hero-shape hero-shape-one" aria-hidden="true"></div>
      <div class="hero-shape hero-shape-two" aria-hidden="true"></div>
      <div class="home-wrap">
        <div class="hero-meta">
          <span>LOCAL AGENT SYSTEM</span>
          <span>MACOS + WINDOWS</span>
          <span class="hero-meta-live"><i></i> DESKTOP BUILD LIVE</span>
        </div>

        <div class="hero-layout">
          <div class="hero-copy">
            <p class="home-kicker">0xCopilot / Work, not answers</p>
            <h1>
              Chat was<br />
              the <span class="strike-word">demo.</span><br />
              <em>The job is<br />the product.</em>
            </h1>
            <p class="hero-dek">
              Give 0xCopilot an outcome. It plans the work, moves through your
              files and connected tools, and stops for your approval before the
              important parts leave the building.
            </p>
            <div class="home-actions">
              <a class="home-btn home-btn-solid" href="./install.html">
                Get the desktop app <span>↘</span>
              </a>
              <a class="home-btn home-btn-line" href="#proof">
                See a run <span>↓</span>
              </a>
            </div>
          </div>

          <div class="hero-console" aria-label="Example 0xCopilot run">
            <div class="console-head">
              <div>
                <span class="console-label">RUN / 0X-284</span>
                <strong>Treasury reporting</strong>
              </div>
              <span class="console-state"><i></i> WORKING</span>
            </div>
            <div class="console-goal">
              <span>GOAL</span>
              <p>
                Reconcile the contributor sheet, stage this week’s transfers,
                and draft the community update.
              </p>
            </div>
            <ol class="event-list">
              <li class="event-done">
                <span class="event-time">12:04:03</span>
                <span class="event-name">sheet.read</span>
                <span class="event-arg">contributors.xlsx</span>
                <b>DONE</b>
              </li>
              <li class="event-done">
                <span class="event-time">12:04:06</span>
                <span class="event-name">safe.tx.staged</span>
                <span class="event-arg">3,100 USDC</span>
                <b>DONE</b>
              </li>
              <li class="event-live">
                <span class="event-time">12:04:09</span>
                <span class="event-name">x.thread.draft</span>
                <span class="event-arg">64% complete</span>
                <b>LIVE</b>
              </li>
            </ol>
            <div class="approval-slip">
              <div>
                <span>PERMISSION GATE</span>
                <strong>Send 3,100 USDC to nova.eth?</strong>
              </div>
              <div class="approval-actions" aria-hidden="true">
                <span>APPROVE</span>
                <span>REDIRECT</span>
                <span>STOP</span>
              </div>
            </div>
            <div class="console-sequence">
              <span>SEQ 000</span>
              <div><i></i></div>
              <span>SEQ 128 / NOW</span>
            </div>
          </div>
        </div>

        <div class="hero-note">
          <span class="hero-note-index">※</span>
          <p>
            Runs on your machine. Bring your own model key. Read every action in
            the open-source event log.
          </p>
        </div>
      </div>
    </header>

    <aside class="signal-strip" aria-label="Product qualities">
      <div class="signal-track">
        <span>LOCAL-FIRST</span><i>✦</i><span>OPEN SOURCE</span><i>✦</i>
        <span>BYOK</span><i>✦</i><span>APPROVAL GATES</span><i>✦</i>
        <span>REPLAYABLE RUNS</span><i>✦</i><span>LOCAL-FIRST</span><i>✦</i>
        <span>OPEN SOURCE</span><i>✦</i><span>BYOK</span><i>✦</i>
        <span>APPROVAL GATES</span><i>✦</i><span>REPLAYABLE RUNS</span><i>✦</i>
      </div>
    </aside>

    <section class="manifesto" id="proof">
      <div class="home-wrap">
        <div class="section-index">
          <span>(A)</span>
          <span>THE MISSING WORKSTATION</span>
        </div>
        <div class="manifesto-grid">
          <h2>
            AI for people whose work
            <span>doesn’t live in a repo.</span>
          </h2>
          <div class="manifesto-copy">
            <p>
              Treasury. Community. Governance. Growth. Operations. The work
              crosses a sheet, a thread, a wallet, and three browser tabs before
              lunch.
            </p>
            <p>
              0xCopilot gives that work an agentic home: one place to start it,
              see it, interrupt it, and find it again.
            </p>
          </div>
        </div>

      </div>
    </section>

    <section class="journey-section" id="work">
      <div class="home-wrap">
        <div class="section-index section-index-light">
          <span>(B)</span>
          <span>ONE RUN / END TO END</span>
        </div>
        <div class="journey-heading">
          <h2>The job has<br /><em>a visible path.</em></h2>
          <p>
            One outcome becomes a visible sequence: define the work, watch it
            happen, then keep both the result and the receipt.
          </p>
        </div>
        <div class="journey-grid">
          {
            JOURNEY.map((moment) => (
              <article class="journey-card">
                <div class="journey-card-top">
                  <span>{moment.no}</span>
                  <span>{moment.stage}</span>
                </div>
                <h3>{moment.title}</h3>
                <p>{moment.body}</p>
                <div class="journey-screen">
                  <span>PRODUCT MOMENT</span>
                  <strong>{moment.screen}</strong>
                </div>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <section class="surfaces-section">
      <div class="home-wrap">
        <div class="section-index">
          <span>(C)</span>
          <span>THE WORK LANDS SOMEWHERE</span>
        </div>
        <div class="surfaces-heading">
          <h2>One agent.<br />Six places to land.</h2>
          <p>
            Chat is one surface, not the whole product. Every kind of work gets
            a proper destination you can reopen, filter, and act on.
          </p>
        </div>
        <div class="surface-stack">
          {
            SURFACES.map(([no, name, desc]) => (
              <div class="surface-row">
                <span>{no}</span>
                <strong>{name}</strong>
                <p>{desc}</p>
                <i aria-hidden="true">↗</i>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <section class="local-section" id="local">
      <div class="local-orbit" aria-hidden="true">
        <span>YOUR MODEL</span>
        <i></i>
        <b>YOUR MACHINE</b>
      </div>
      <div class="home-wrap">
        <div class="section-index section-index-light">
          <span>(D)</span>
          <span>SOVEREIGN BY DEFAULT</span>
        </div>
        <div class="local-grid">
          <h2>
            Powerful enough<br />
            to act. <em>Local enough</em><br />
            to unplug.
          </h2>
          <div class="local-copy">
            <p>
              Bring your own API key. Choose OpenAI, Anthropic, Google, or point
              the runtime at a local model. No seat license and no mystery model
              between you and your work.
            </p>
            <ul>
              <li><span>01</span> Keys stay out of run request bodies</li>
              <li><span>02</span> Connector tokens live in your vault</li>
              <li><span>03</span> The runtime and event log stay local</li>
            </ul>
          </div>
        </div>
        <div class="provider-wall" aria-label="Supported model providers">
          <span>OPENAI</span><span>ANTHROPIC</span><span>GOOGLE</span
          ><span>LOCAL</span>
        </div>
      </div>
    </section>

    <section class="install-section">
      <div class="home-wrap">
        <div class="section-index">
          <span>(E)</span>
          <span>GET THE APP</span>
        </div>
        <div class="install-grid">
          <div>
            <h2>One command.<br /><em>Zero ceremony.</em></h2>
            <p>
              macOS and Windows. The first run stages a self-contained local
              runtime and opens the desktop app.
            </p>
          </div>
          <div class="command-block">
            <div class="command-top">
              <span>TERMINAL / 0XCOPILOT</span>
              <span>NODE 20+</span>
            </div>
            <code><i>$</i> npm install -g @0x-copilot/cli</code>
            <code><i>$</i> copilot<span class="command-cursor"></span></code>
            <a href="./install.html">INSTALL NOTES ↗</a>
          </div>
        </div>
      </div>
    </section>

    <section class="token-section">
      <div class="home-wrap token-grid">
        <div>
          <span class="token-label">$CPILOT / ROBINHOOD CHAIN</span>
          <h2>The app is the product.<br />The token funds the road.</h2>
        </div>
        <div class="token-stats">
          <div><strong>45.56%</strong><span>Liquidity</span></div>
          <div><strong>29.19%</strong><span>Team + contributors</span></div>
          <div><strong>25%</strong><span>Capital formation</span></div>
        </div>
        <div class="token-actions">
          <a href="./token.html">Read the tokenomics ↗</a>
          <a href={VIRTUALS} rel="noopener">View on Virtuals ↗</a>
        </div>
      </div>
    </section>

    <section class="last-call" id="contact">
      <div class="home-wrap">
        <p>THE NEXT RUN IS YOURS.</p>
        <h2>Give it a goal.<br /><em>Keep your hands on the wheel.</em></h2>
        <div class="last-actions">
          <a class="home-btn home-btn-solid" href="./install.html">
            Get 0xCopilot <span>↘</span>
          </a>
          <a href={REPO} rel="noopener">GitHub ↗</a>
          <a href={DISCORD} rel="noopener">Discord ↗</a>
          <a href={X} rel="noopener">X / @Copilot0x ↗</a>
        </div>
      </div>
    </section>
  </main>

  <footer class="home-footer">
    <div class="home-wrap">
      <div class="home-footer-mark">0x<span>Copilot</span></div>
      <div class="home-footer-meta">
        <span>© 2026 0xCopilot</span>
        <span>OPEN SOURCE / LOCAL-FIRST / BYOK</span>
        <span>Nothing here is financial advice.</span>
      </div>
    </div>
  </footer>
</Base>

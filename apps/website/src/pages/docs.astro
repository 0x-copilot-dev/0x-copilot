---
import Base from "../layouts/Base.astro";
import Nav from "../components/Nav.astro";
import "../styles/docs.css";

const REPO = "https://github.com/0x-copilot-dev/0x-copilot";
const DISCORD = "https://discord.com/invite/NhCv7zDkmX";

const chapters = [
  {
    no: "01",
    group: "Start here",
    title: "Install 0xCopilot",
    body: "Stage the local runtime, open the desktop app, and run the built-in health check.",
    href: "./install.html",
    status: "READ NOW",
  },
  {
    no: "02",
    group: "Start here",
    title: "Your first run",
    body: "Give the agent an outcome, watch the event stream, and understand permission gates.",
    status: "COMING SOON",
  },
  {
    no: "03",
    group: "Use the system",
    title: "Tools + connectors",
    body: "Connect the systems where your work already lives and control what each one may do.",
    status: "COMING SOON",
  },
  {
    no: "04",
    group: "Use the system",
    title: "Skills + memory",
    body: "Teach repeatable procedures and decide what context should survive across runs.",
    status: "COMING SOON",
  },
  {
    no: "05",
    group: "Control",
    title: "Approvals + audit",
    body: "Set permission boundaries, inspect typed events, reconnect to a run, and replay its history.",
    status: "COMING SOON",
  },
  {
    no: "06",
    group: "Build + operate",
    title: "Source + self-hosting",
    body: "Read the architecture, build each service independently, or run the complete stack yourself.",
    href: REPO,
    external: true,
    status: "VIEW SOURCE",
  },
];
---

<Base
  title="Documentation — 0xCopilot"
  description="The operating manual for installing, using, connecting, and self-hosting 0xCopilot."
  bodyClass="docs-site"
  themeColor="#f2eddf"
  fontHref="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wdth,wght@12..96,75..100,300..800&family=DM+Mono:wght@300;400;500&family=Instrument+Serif:ital@0;1&display=swap"
>
  <Nav variant="nav-docs" />

  <main>
    <header class="docs-hero">
      <div class="docs-grid" aria-hidden="true"></div>
      <div class="docs-wrap">
        <div class="docs-meta">
          <span>0xCOPILOT / FIELD MANUAL</span>
          <span>DOCS INDEX / REV 0.1</span>
          <span><i></i> FIRST CHAPTER LIVE</span>
        </div>
        <div class="docs-hero-layout">
          <div>
            <p class="docs-kicker">DOCUMENT THE SYSTEM, NOT THE SLOGAN</p>
            <h1>The operating<br /><em>manual.</em></h1>
          </div>
          <div class="docs-intro">
            <p>
              A practical guide to installing 0xCopilot, giving it real work,
              connecting tools, setting boundaries, and running the stack
              yourself.
            </p>
            <div class="docs-actions">
              <a class="docs-button docs-button-solid" href="./install.html"
                >Install the app <span>↘</span></a
              >
              <a
                class="docs-button"
                href={REPO}
                target="_blank"
                rel="noopener noreferrer">GitHub <span>↗</span></a
              >
            </div>
          </div>
        </div>
      </div>
    </header>

    <section class="docs-index">
      <div class="docs-wrap">
        <div class="docs-section-label">
          <span>(A)</span>
          <span>DOCUMENTATION INDEX</span>
          <span>01 LIVE / 05 IN PROGRESS</span>
        </div>

        <div class="chapter-grid">
          {
            chapters.map((chapter) =>
              chapter.href ? (
                <a
                  class="chapter chapter-live"
                  href={chapter.href}
                  target={chapter.external ? "_blank" : undefined}
                  rel={chapter.external ? "noopener noreferrer" : undefined}
                >
                  <span class="chapter-no">{chapter.no}</span>
                  <span class="chapter-group">{chapter.group}</span>
                  <h2>{chapter.title}</h2>
                  <p>{chapter.body}</p>
                  <span class="chapter-status">{chapter.status} ↗</span>
                </a>
              ) : (
                <article class="chapter">
                  <span class="chapter-no">{chapter.no}</span>
                  <span class="chapter-group">{chapter.group}</span>
                  <h2>{chapter.title}</h2>
                  <p>{chapter.body}</p>
                  <span class="chapter-status">{chapter.status}</span>
                </article>
              ),
            )
          }
        </div>
      </div>
    </section>

    <section class="docs-principle">
      <div class="docs-wrap principle-grid">
        <div class="principle-mark">※</div>
        <div>
          <p>HOW THESE DOCS WILL WORK</p>
          <h2>
            Short paths for getting started.<br />
            <em>Deep references when the work gets real.</em>
          </h2>
        </div>
        <p class="principle-copy">
          The structure follows the useful part of a mature agent manual:
          installation first, then daily use, integrations, control, and finally
          the developer reference. No marketing copy disguised as instructions.
        </p>
      </div>
    </section>

    <section class="docs-community">
      <div class="docs-wrap community-grid">
        <div>
          <span>CAN'T FIND IT YET?</span>
          <h2>Ask in the open.</h2>
        </div>
        <p>
          The manual is being written alongside the product. Until a chapter is
          live, use GitHub for source-level questions and Discord for help from
          the community.
        </p>
        <div class="community-actions">
          <a href={DISCORD} target="_blank" rel="noopener noreferrer"
            >Discord ↗</a
          >
          <a href={REPO} target="_blank" rel="noopener noreferrer">GitHub ↗</a>
        </div>
      </div>
    </section>
  </main>

  <footer class="docs-footer">
    <div class="docs-wrap">
      <strong>0xCopilot</strong>
      <span>LOCAL-FIRST / OPEN SOURCE / BYOK</span>
      <span>DOCS REV 0.1 / 2026</span>
    </div>
  </footer>
</Base>

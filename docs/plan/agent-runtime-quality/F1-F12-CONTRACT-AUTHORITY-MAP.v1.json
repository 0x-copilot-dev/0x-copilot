{
  "schema_version": "1.0.0",
  "map_id": "agent-runtime-quality.f1-f12.contract-authority-map",
  "description": "Desktop-first B2C authority assignments for every F1-F12 domain record and declared event, plus the shared production-integration control records and closed run-event families.",
  "authority_semantics": {
    "primary": "The only authority that may define and durably originate the canonical record or event.",
    "supporting": "An authority that supplies trusted inputs or execution support without becoming a second canonical writer.",
    "consumer": "An authority that may read, project, or present the contract but may not rewrite canonical truth."
  },
  "authorities": {
    "ai-backend": {
      "root_path": "services/ai-backend",
      "description": "Owns runtime, run-scoped domain records, the monotonic run event journal, model/tool orchestration, workspace overlay state, and local evaluation artifacts."
    },
    "backend": {
      "root_path": "services/backend",
      "description": "Owns product identity and policy state, MCP registration, OAuth and credential custody, descriptor revisions, and remote MCP transport/session lifecycle."
    },
    "desktop": {
      "root_path": "apps/desktop",
      "description": "Owns the shipped local process lifecycle and the C2 host-workspace prepare, commit, drift, reconcile, and undo authority; renderer code is never an authority source."
    }
  },
